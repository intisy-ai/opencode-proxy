{
  "name": "opencode-proxy",
  "version": "1.0.0",
  "description": "The OpenCode proxy layer (opencodeProfile) on top of the generic core-proxy engine",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "author": "intisy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intisy-ai/opencode-proxy.git"
  },
  "keywords": [
    "proxy",
    "routing",
    "anthropic",
    "opencode",
    "intisy",
    "opencode-proxy"
  ],
  "files": [
    "dist/",
    "plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npx tsc && npx esbuild src/frontdoor.ts --bundle --platform=node --format=esm --outfile=dist/frontdoor.mjs && node scripts/postbuild-deploy.mjs",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@intisy-ai/anthropic-translator": "^1.1.0",
    "@intisy-ai/core-ir": "^1.3.0",
    "@intisy-ai/core-proxy": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
